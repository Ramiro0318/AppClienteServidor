<UserControl x:Class="Kanbanhttp.Views.EliminarUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Kanbanhttp.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Background="#50000000">
    <DockPanel Background="WhiteSmoke" Width="350" Height="150">
        <TextBlock Background="Blue" Foreground="White" Padding="5" DockPanel.Dock="Top">Confirme la eliminación</TextBlock>
        <WrapPanel DockPanel.Dock="Bottom" Margin="10" HorizontalAlignment="Center">
            <Button Padding="20,5" Margin="5,0,0,0">Si</Button>
            <Button Padding="20,5" Margin="5,0,0,0">No</Button>
        </WrapPanel>
        <TextBlock Padding="30" HorizontalAlignment="Center" FontSize="14">¿Está seguro qde eliminar la actividad seleccionada?</TextBlock>
    </DockPanel>
</UserControl>
